<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Product | FarmStand</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="logo">FarmStand</div>
        <div class="navbar-right">
            <a href="/products" class="btn-add">All Products</a>
        </div>
    </nav>

    <main>
        <div class="form-container">
            <h1>Add a New Product</h1>
            <form action="/products" method="POST" class="product-form">
                <label for="name">Product Name (Specify quantity)</label>
                <input type="text" name="name" id="name" placeholder="Enter the product name" required>

                <label for="price">Product Price</label>
                <input type="number" name="price" id="price" placeholder="Enter the price of the product" required>

                <label for="category">Product Category</label>
                <select name="category" id="category" required>
                    <% for (let c of categories) { %>
                        <option value="<%= c %>"><%= c %></option>
                    <% } %>
                </select>

                <label for="image">Product Image URL</label>
                <input type="url" name="image" id="image" placeholder="Enter image URL (optional)">

                <button type="submit" class="btn-submit">Add Product</button>
            </form>
        </div>
    </main>

    <footer class="footer">
        <p>© <%= new Date().getFullYear() %> FarmStand. All rights reserved.</p>
    </footer>
</body>
</html>
