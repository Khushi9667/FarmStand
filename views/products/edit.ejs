<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product | FarmStand</title>
    <link rel="stylesheet" href="/css/style.css">
</head>
<body>
    <nav class="navbar">
        <div class="logo">FarmStand</div>
        <div class="navbar-right">
            <a href="/products" class="btn-add">All Products</a>
        </div>
    </nav>

    <main>
        <div class="form-container">
            <h1>Edit Product</h1>
            <form action="/products/<%= product._id %>?_method=PUT" method="POST" class="product-form">
                <label for="name">Product Name</label>
                <input type="text" name="name" id="name" value="<%= product.name %>" required>

                <label for="price">Product Price</label>
                <input type="number" name="price" id="price" value="<%= product.price %>" required>

                <label for="category">Product Category</label>
                <select name="category" id="category" required>
                    <% for (let c of categories) { %>
                        <option value="<%= c %>" <%= product.category === c ? 'selected' : '' %>><%= c %></option>
                    <% } %>
                </select>

                <label for="image">Product Image URL</label>
                <input type="url" name="image" id="image" value="<%= product.image %>" placeholder="Enter image URL">

                <div class="form-actions">
                    <button type="submit" class="btn-submit">Update</button>
                    <a href="/products/<%= product._id %>" class="btn-cancel">Cancel</a>
                </div>
            </form>
        </div>
    </main>

    <footer class="footer">
        <p>© <%= new Date().getFullYear() %> FarmStand. All rights reserved.</p>
    </footer>
</body>
</html>
